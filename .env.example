# ─────────────────────────────────────────────────────────────
# nexana Trend-Radar – Umgebungsvariablen
# Kopieren nach `.env` und ausfüllen. `.env` wird nie committet.
# Alle API-Keys sind optional: fehlt ein Key, läuft die Quelle im Mock-Modus.
# ─────────────────────────────────────────────────────────────

# Pflicht: PostgreSQL-Verbindung (lokal oder Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trend_radar"

# Pflicht: Passwortschutz des Dashboards
DASHBOARD_PASSWORD=""
# Pflicht: mind. 32 zufällige Zeichen, z. B. `openssl rand -hex 32`
SESSION_SECRET=""

# Optional: SerpApi (Google Trends + Google Shopping). Leer = Mock-Modus.
SERPAPI_API_KEY=""

# Optional: AliExpress Open Platform (Affiliate API). Alle drei nötig, sonst Mock-Modus.
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID=""

# Optional: Claude für das Matching. Leer = heuristisches Matching.
ANTHROPIC_API_KEY=""
# Modell für Matching, Hashtag-Auswahl und Übersetzung.
# Default: claude-haiku-4-5 (am günstigsten). Bei unzureichender Match-Qualität: claude-sonnet-5.
ANTHROPIC_MODEL="claude-haiku-4-5"

# Optional (Phase 2): Meta Ad Library API. Leer = Mock-Modus.
# Langlebiger User-Token (60 Tage gültig) einer Meta-Entwickler-App mit bestätigter Identität.
META_ACCESS_TOKEN=""
# Optional: App-ID und -Secret, damit `collect` vor Ablauf des Tokens warnt
META_APP_ID=""
META_APP_SECRET=""

# Optional (Phase 2): TikTok Commercial Content API (nach Zulassung durch TikTok). Leer = Mock-Modus.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Optional (Phase 2b): Apify-Token für Scraping (TikTok Creative Center, 1688). Leer = Mock-Modus.
# Achtung: Scraping verstößt gegen die Nutzungsbedingungen dieser Plattformen (siehe README).
APIFY_TOKEN=""
