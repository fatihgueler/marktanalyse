# ─────────────────────────────────────────────────────────────
# nexana Trend-Radar – Umgebungsvariablen
# Kopieren nach `.env` und ausfüllen. `.env` wird nie committet.
# Alle API-Keys sind optional: fehlt ein Key, läuft die Quelle im Mock-Modus.
# ─────────────────────────────────────────────────────────────

# Pflicht: PostgreSQL-Verbindung (lokal oder Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trend_radar"

# Pflicht: Passwortschutz des Dashboards
DASHBOARD_PASSWORD=""
# Pflicht: mind. 32 zufällige Zeichen, z. B. `openssl rand -hex 32`
SESSION_SECRET=""

# Optional: SerpApi (Google Trends + Google Shopping). Leer = Mock-Modus.
SERPAPI_API_KEY=""

# Optional: AliExpress Open Platform (Affiliate API). Alle drei nötig, sonst Mock-Modus.
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID=""

# Optional: Claude für das Matching. Leer = heuristisches Matching.
ANTHROPIC_API_KEY=""
# Modell für das Matching (Default: claude-opus-5; günstiger z. B. claude-sonnet-5)
ANTHROPIC_MODEL="claude-opus-5"
